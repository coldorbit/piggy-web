NODE_ENV=production

DATABASE_URL=postgres://user:password@your-rds-endpoint.us-east-1.rds.amazonaws.com:5432/applypilot
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false

OPENAI_API_KEY=sk-your-api-key-here
OPENAI_TIMEOUT_SECONDS=300
OPENAI_MODEL=gpt-5-mini

R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-private-resume-bucket
RABBITMQ_URL=amqps://user:password@rabbitmq.example.com:5671/vhost
TAILORING_QUEUE_NAME=applypilot.tailoring

TAILORING_CONCURRENCY=4
TAILORING_MAX_ATTEMPTS=3
TAILORING_STALE_PROCESSING_SECONDS=600
